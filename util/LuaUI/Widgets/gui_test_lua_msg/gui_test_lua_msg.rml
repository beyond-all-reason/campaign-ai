<rml>

    <head>
        <title>LuaMsg demo</title>
        <link rel="stylesheet" href="gui_test_lua_msg.rcss" type="text/rcss" />
    </head>

    <body id="gui_test_lua_msg-widget" class="intent-root" data-class-collapsed="isCollapsed">
        <div id="widget-container" data-model="gui_test_lua_msg_model" class="panel">
            <!-- Small floating debug buttons -->
            <!-- <div class="debug-controls">
                <button class="globallos-btn" data-class-active="globallosEnabled" onclick="widget:Reload()" title="Reload Widget">r</button>
                <button onclick="widget:ToggleDebugger()" title="Toggle Debugger">d</button>
            </div> -->
            <handle move_target="#document">
                <div class="navbar">
                    <h1 class="text-white">Intent</h1>
                    <div class="window-controls">
                        <button class="winbtn close" data-event-click="closeWidget()" title="Close">X</button>
                    </div>
                </div>
            </handle>
            <div class="content give intent-collapsible" data-class-collapsed="isCollapsed">
                <div class="grid commands">
<!--                    <button onclick="widget:SendCommand('cheat')">cheat</button>
                    <button onclick="widget:SendCommand('globallos')">global los</button>
                    <button onclick="widget:SendCommand('godmode')">godmode</button>
                    <button onclick="widget:SendCommand('nocost')">nocost</button>
                    <button onclick="widget:SendCommand('atm')">atm</button>
                    <button onclick="widget:SendCommand('luarules clearwrecks')">no wrecks</button>
                    <button onclick="widget:SendCommand('luarules loadmissiles')">missiles</button>
                    <button class="danger" onclick="widget:SendCommand('option restart')">restart</button>
                    <button onclick="widget:PauseAI()">toggle AI</button>
                    <button class="danger" onclick="widget:SendCommand('spectator')">spectator</button>-->
                    <button onclick="widget:SendCommand('pause')">pause</button>
                    <button onclick="widget:SendCommand('setspeed 1')">x1</button>
                    <button onclick="widget:SendCommand('setspeed 2')">x2</button>
                    <button onclick="widget:SendCommand('setspeed 4')">x4</button>
                    <button onclick="widget:SendCommand('setspeed 10')">x10</button>
                    <button onclick="widget:SendCommand('setspeed 20')">x20</button>
                </div>
            </div>
            <tabset class="content give intent-collapsible" data-class-collapsed="isCollapsed">
                <tab>Misc</tab>
                <panel>
                <div class="grid commands">
                    <button onclick="widget:SendUnitDefRetreat1Intent()">retreat0.5</button>
                    <button onclick="widget:SendUnitDefRetreat2Intent()">retreat1.0</button>
                    <button onclick="widget:SendDeactivateFactoryIntent()">Deactivate Factory</button>
                    <button onclick="widget:SendActivateFactoryIntent()">Activate Factory</button>
                    <button onclick="widget:SendEnableUnitsMsg()">Enable Units</button>
                    <button onclick="widget:SendDisableUnitsMsg()">Disable Units</button>
                    <button onclick="widget:ToggleScriptedRectruit()">Scripted recruit</button>
                </div>
                </panel>

                <tab>Squad</tab>
                <panel>
                <div class="grid commands">
                    <button onclick="widget:SendNewSquad1()">New Squad1</button>
                    <button onclick="widget:SendNewSquad2()">New Squad2</button>
                    <button onclick="widget:SendNewSquad3()">New Squad3</button>
                    <button onclick="widget:SendSelectSquad1()">Select Squad1</button>
                    <button onclick="widget:SendSelectSquad2()">Select Squad2</button>
                    <button onclick="widget:SendSelectSquad3()">Select Squad3</button>
                    <button onclick="widget:SendCancelReq1()">Cancel Req1</button>
                    <button onclick="widget:SendCancelReq2()">Cancel Req2</button>
                    <button onclick="widget:SendCancelReq3()">Cancel Req3</button>
                    <button onclick="widget:SendCancelSquad1()">Cancel Squad1</button>
                    <button onclick="widget:SendCancelSquad2()">Cancel Squad2</button>
                    <button onclick="widget:SendCancelSquad3()">Cancel Squad3</button>
                    <button onclick="widget:SendCompose1Squad2()">Comp1 AK</button>
                    <button onclick="widget:SendCompose2Squad2()">Comp2 Tanks</button>
                    <button onclick="widget:SendCompose3Squad2()">Comp2 Std</button>
                </div>
                <div class="grid commands">
                    <button onclick="widget:SendTaskDefend()">defend</button>
                    <button onclick="widget:SendTaskScout()">scout</button>
                    <button onclick="widget:SendTaskRaid()">raid</button>
                    <button onclick="widget:SendTaskAttack()">attack</button>
                    <button onclick="widget:SendTaskBomb()">bomb</button>
                    <button onclick="widget:SendTaskArty()">arty</button>
                    <button onclick="widget:SendTaskAA()">AA</button>
                    <button onclick="widget:SendTaskSupport()">support</button>
                </div>
                <div class="grid commands">
                    <button onclick="widget:SetPathParamThreat()">set path param</button>
                    <button onclick="widget:ClearPathParamThreat()">clear path param</button>
                </div>
                <div class="grid commands">
                    <button onclick="widget:SendDozenSquads()">10 squads</button>
                    <button onclick="widget:CancelDozenSquads()">del squads</button>
                    <button onclick="widget:SendPriorityTarget()">target</button>
                </div>
                <div class="grid commands">
                    <button onclick="widget:SendEscortTask()">escort</button>
                    <button onclick="widget:SendEscortRangeBig()">2000 range</button>
                    <button onclick="widget:SendEscortRangeSmall()">100 range</button>
                </div>
                </panel>

                <tab>Region</tab>
                <panel><div class="grid commands">
                    <button onclick="widget:SendRegion1()">region 1</button>
                    <button onclick="widget:SendRegion2()">region 2</button>
                    <button onclick="widget:StartRegion()">start build</button>
                    <button onclick="widget:EndRegion()">end build</button>
                    <button onclick="widget:ClearRegions()">clear builds</button>
                </div>
                <div class="grid commands">
                    <button onclick="widget:StartReservedRegion()">start reserved</button>
                    <button onclick="widget:EndReservedRegion()">end reserved</button>
                    <button onclick="widget:ClearReserved()">clear reserved</button>
                </div>
                <div class="grid commands">
                    <button onclick="widget:StartTriggerRegion()">start trigger</button>
                    <button onclick="widget:EndTriggerRegion()">end trigger</button>
                    <button onclick="widget:ClearTriggers()">clear triggers</button>
                </div></panel>

                <tab>Base</tab>
                <panel>
                <div class="grid commands">
                    <button onclick="widget:SendBasePos()">base pos</button>
                    <button onclick="widget:SendMetalPos()">metal pos</button>
                    <button onclick="widget:SendCheapEnergyPos()">cheap energy pos</button>
                    <button onclick="widget:SendModerateEnergyPos()">moderate energy pos</button>
                    <button onclick="widget:SendExpensiveEnergyPos()">expensive energy pos</button>
                </div>
                <div class="grid commands">
                    <button onclick="widget:SendReclaimConvertEff()">reclaim convert efficiency</button>
                    <button onclick="widget:SendReclaimEnergyEff()">ereclaim energy efficiency</button>
                </div>
                <div class="grid commands">
                    <button onclick="widget:SendNewBase()">base loadout</button>
                    <button onclick="widget:StartAllowedRegion()">start allowed</button>
                    <button onclick="widget:EndAllowedRegion()">end allowed</button>
                    <button onclick="widget:ClearAllowed()">clear allowed</button>
                    <button onclick="widget:AllowNone()">forbid all</button>
                    <button onclick="widget:AllowAll()">allow all</button>
                </div>
                <div class="grid commands">
                    <button onclick="widget:SendMexCap(0.2, false)">mex 0.3</button>
                    <button onclick="widget:SendMexCap(0.5, true)">mex 0.5</button>
                    <button onclick="widget:SendMexCap(2.0, false)">mex 2.0</button>
                </div>
                </panel>

                <tab>AI State</tab>
                <panel>
                <div class="grid commands">
                    <button onclick="widget:AiSetState('enabled')">enable</button>
                    <button onclick="widget:AiSetState('disabled')">disable</button>
                </div>
                <div class="grid commands">
                    <button onclick="widget:AiSetState('passive')">passive</button>
                    <button onclick="widget:AiSetState('defensive')">defensive</button>
                    <button onclick="widget:AiSetState('normal')">normal</button>
                    <button onclick="widget:AiSetState('aggressive')">aggressive</button>
                </div>
                </panel>
            </tabset>
            <div class="collapse-button" data-event-click="toggleCollapse()" title="Minimize" data-class-collapsed="isCollapsed"></div>
        </div>
    </body>
</rml>
